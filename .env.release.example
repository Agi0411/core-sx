# macOS Developer ID signing / notarization examples.
# Never commit real credentials.

# Option A: signing certificate exported from Keychain Access
CSC_LINK=/absolute/path/to/Developer-ID-Application.p12
CSC_KEY_PASSWORD=your_p12_password

# Or install the Developer ID Application certificate in your login keychain and use:
# CSC_NAME=Developer ID Application: Your Name (TEAMID)

# Option A: App Store Connect API key (recommended)
APPLE_API_KEY=/absolute/path/to/AuthKey_ABC123XYZ.p8
APPLE_API_KEY_ID=ABC123XYZ
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# Option B: Apple ID + app-specific password
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ABCDE12345
